# Which agent engine runs the roles: mock | claude | bob
#   mock   — no model calls; deterministic stand-ins so the whole flow can be demoed
#   claude — Claude Code CLI in headless mode (`claude -p ... --output-format stream-json`)
#   bob    — IBM Bob Shell (`bob run "<prompt>"`); set ARROW_BOB_ARGS if your build differs
ARROW_DRIVER=mock

# Per-role override, e.g. strong model plans, cheaper one builds:
# ARROW_DRIVER_ARCHITECT=claude
# ARROW_DRIVER_WORKER=bob

# The executable each driver calls (a wrapper script works too)
ARROW_CLAUDE_CMD=claude
ARROW_BOB_CMD=bob
ARROW_BOB_ARGS=run

# Limits
ARROW_PARALLEL=3            # workers at once (only file-disjoint packets run together)
ARROW_AGENT_TIMEOUT_S=1800  # an agent past this is asked to stop; its work is kept
ARROW_MOCK_DELAY_MS=1200    # how long each mock agent "works", so the UI can be watched
